# ══════════════════════════════════════════════════════════════
# Build arguments
# ══════════════════════════════════════════════════════════════
ARG PHP_VERSION=8.4
ARG ALPINE_VERSION=3.23
ARG BASE_IMAGE=php:${PHP_VERSION}-zts-alpine${ALPINE_VERSION}

# Toggles -DOXPHP_WITH_PROFILER=1 in both C build stages. Production
# feature set includes plugin-profiler, so the default is 1. Kept as an
# ARG for local smoke-tests of a profiler-less binary (paired with a
# matching edit to the --features list below).
ARG OXPHP_WITH_PROFILER=1

# ══════════════════════════════════════════════════════════════
# Stage 1: Build bridge library
# ══════════════════════════════════════════════════════════════
FROM ${BASE_IMAGE} AS bridge-builder

ARG OXPHP_WITH_PROFILER

RUN apk add --no-cache gcc musl-dev make

WORKDIR /build
COPY ext/bridge/ ./

RUN export EXTRA_CFLAGS="$([ "${OXPHP_WITH_PROFILER}" = "1" ] && echo '-DOXPHP_WITH_PROFILER=1')" && \
    make && make install

# ══════════════════════════════════════════════════════════════
# Stage 2: Build PHP extension (oxphp_sapi.so)
# ══════════════════════════════════════════════════════════════
FROM ${BASE_IMAGE} AS ext-builder

ARG OXPHP_WITH_PROFILER

RUN apk add --no-cache gcc musl-dev make autoconf

COPY --from=bridge-builder /usr/local/lib/liboxphp_bridge.so /usr/local/lib/
COPY --from=bridge-builder /usr/local/include/oxphp_bridge.h /usr/local/include/

WORKDIR /build/ext
COPY ext/config.m4 ext/php_oxphp_sapi.h ext/oxphp_sapi.c ext/oxphp_fiber.h ext/oxphp_fiber.c ./
COPY ext/bridge/oxphp_bridge.h ./bridge/

RUN phpize && \
    CPPFLAGS="$([ "${OXPHP_WITH_PROFILER}" = "1" ] && echo '-DOXPHP_WITH_PROFILER=1')" \
        ./configure --enable-oxphp-sapi && \
    make && \
    make install

# ══════════════════════════════════════════════════════════════
# Stage 3: Build Rust binary with the fixed production feature set.
# Production builds always include plugin-apm, plugin-async,
# plugin-profiler, and plugin-shared — this is the distinguishing
# trait of Dockerfile.alpine-release vs Dockerfile. To change the
# production feature set, edit this file directly (and the matching
# OXPHP_WITH_PROFILER build-arg if the profiler is involved).
# ══════════════════════════════════════════════════════════════
FROM ${BASE_IMAGE} AS builder

RUN apk add --no-cache \
    rust \
    cargo \
    gcc \
    musl-dev \
    pkgconfig \
    readline-dev \
    ncurses-dev \
    curl-dev \
    oniguruma-dev \
    sqlite-dev \
    argon2-dev \
    libxml2-dev \
    zlib-dev \
    openssl-dev \
    gnu-libiconv-dev \
    protobuf-dev

COPY --from=bridge-builder /usr/local/lib/liboxphp_bridge.so /usr/local/lib/
COPY --from=bridge-builder /usr/local/include/oxphp_bridge.h /usr/local/include/

WORKDIR /build

# Version injected from CI. Tag v1.2.3 → OXPHP_VERSION=1.2.3.
# Default "0.0.0-dev" is only used for local test builds of this file
# outside of CI (useful when manually smoke-testing the prod Dockerfile).
ARG OXPHP_VERSION="0.0.0-dev"

COPY Cargo.toml Cargo.lock ./
# build.rs runs prost_build::compile_protos unconditionally, so proto/
# must be present even for the dep-cache build below.
COPY proto ./proto
COPY build.rs ./

# Cache dependency compilation with production feature set baked in.
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    touch src/lib.rs && \
    cargo build --release --features plugin-apm,plugin-async,plugin-profiler,plugin-shared && \
    rm -rf src target/release/oxphp target/release/deps/oxphp-* target/release/.fingerprint/oxphp-*

COPY src ./src

# Patch Cargo.toml version from the build arg (always applied in prod builds)
RUN sed -i "s/^version = \".*\"/version = \"${OXPHP_VERSION}\"/" Cargo.toml

# Production build — hardcoded feature set, no ARG override.
RUN cargo build --release --features plugin-apm,plugin-async,plugin-profiler,plugin-shared

# ══════════════════════════════════════════════════════════════
# Stage 4: Runtime — minimal production image.
# Ships only the welcome page so users can verify the server boots.
# Users are expected to mount their own webroot and PHP config.
# libgcc must be added explicitly: the Rust-compiled oxphp binary
# dynamically links libgcc_s.so.1, which the PHP base image does not
# ship (it's a gcc runtime dep, not a PHP dep).
# ══════════════════════════════════════════════════════════════
FROM ${BASE_IMAGE}

RUN apk add --no-cache libgcc

# Copy bridge library from bridge-builder
COPY --from=bridge-builder /usr/local/lib/liboxphp_bridge.so /usr/local/lib/

# Copy oxphp SAPI extension from ext-builder (merges into existing
# extensions dir provided by the PHP base image)
COPY --from=ext-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/

# Enable the SAPI extension. Production intentionally does NOT ship an
# oxphp.ini — production users mount their own PHP config.
RUN echo "extension=oxphp_sapi.so" > /usr/local/etc/php/conf.d/extension.ini

# Copy oxphp binary from builder
COPY --from=builder /build/target/release/oxphp /usr/local/bin/oxphp

# Web root (www-data already exists in the PHP base image)
RUN mkdir -p /var/www/html/public && chown -R www-data:www-data /var/www/html

# Welcome page as default index.php — nginx-style landing page so users
# can verify the server responds after first deploy. Production users
# replace this with their own webroot via bind-mount or a downstream FROM.
COPY --chown=www-data:www-data www/public/welcome.php /var/www/html/public/index.php

# Ensure libphp.so and liboxphp_bridge.so are found at runtime
ENV LD_LIBRARY_PATH=/usr/local/lib

EXPOSE 80 443

CMD ["oxphp"]
